{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ai.sh *)",
      "Bash(bash /Users/gustavo/.claude/skills/ai-delegate/scripts/ai.sh *)",
      "Bash(ollama run *)",
      "Bash(ollama list*)",
      "Bash(ollama ps*)",
      "Bash(ollama show *)",
      "Bash(ollama pull *)",
      "Bash(cline -P groq *)",
      "Bash(cline -P ollama *)",
      "Bash(brew services start ollama)",
      "Bash(brew services restart ollama)",
      "Bash(brew services info ollama)",
      "Bash(curl -s localhost:11434/api/tags)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$HOME/.claude/skill-first-reminder.txt\"",
            "timeout": 5,
            "statusMessage": "skill-first check"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/scripts/claude-sync.sh\" pull 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "sync claude-skills (pull)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/skills/scripts/claude-sync.sh\" check 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "check config drift"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/no-em-dash-check.sh\"",
            "timeout": 10,
            "statusMessage": "no-em-dash check"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "xhigh",
  "theme": "dark"
}